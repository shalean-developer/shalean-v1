# Copy to .env.local and fill with real values before connecting live services.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alternative to the anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (server-only secret; public key is safe for the browser) ---
PAYSTACK_SECRET_KEY=
# Optional: publishable key for any client-side Paystack inline usage.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Paystack webhook signature is verified with PAYSTACK_SECRET_KEY (HMAC-SHA512).
# This var is only needed if you configure a separate webhook secret in Paystack.
PAYSTACK_WEBHOOK_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://shalean.co.za
# Absolute base URL used to build Paystack callback + customer payment links from
# server code. Defaults to NEXT_PUBLIC_SITE_URL when unset.
NEXT_PUBLIC_APP_URL=

# --- Resend email notifications (server-only) ---
# API key from https://resend.com. Never exposed to the browser. When missing,
# email sending is safely skipped (recorded as "dry_run") and never crashes a flow.
RESEND_API_KEY=
# Default "from" address for all customer-facing email. Must be on a Resend-verified domain.
EMAIL_FROM="Shalean Cleaning Services <noreply@shalean.com>"
# Internal recipients for admin/ops notifications.
ADMIN_EMAIL=admin@shalean.com
BOOKINGS_EMAIL=bookings@shalean.com
ACCOUNTS_EMAIL=accounts@shalean.com
SUPPORT_EMAIL=support@shalean.com

# --- Cron / background workers (server-only) ---
# Shared secret that pg_cron sends as "Authorization: Bearer <CRON_SECRET>" when
# invoking /api/cron/* routes. Must match the Supabase Vault "cron_secret".
CRON_SECRET=

# --- Zoho Books (server-only accounting sync) ---
# Self-client / refresh-token OAuth credentials from the Zoho API console.
# These are NEVER exposed to the browser. When any required value is missing,
# booking → Zoho sync is safely skipped (status "skipped") and never breaks
# the booking or payment flow.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# Zoho data center: com (US), eu, in, com.au, jp, ca, sa. Defaults to com.
# The Zoho API base URL (ZOHO_API_BASE_URL) is derived from ZOHO_DC
# (e.g. https://www.zohoapis.com/books/v3 for "com"); no separate var is needed.
ZOHO_DC=com
# Paid bookings record a full payment against the Zoho invoice so it shows as
# Paid. Optional: payment mode (default "banktransfer") and the "deposit to"
# account. If ZOHO_PAYMENT_ACCOUNT_ID is unset, the first active bank account is
# used automatically.
ZOHO_PAYMENT_MODE=banktransfer
ZOHO_PAYMENT_ACCOUNT_ID=
